NODE_ENV="development"
APP_URL="http://localhost:3000"
# Local SQLite: file:./dev.db | Production PostgreSQL: postgresql://user:password@localhost:5432/erogaai?schema=public
DATABASE_URL="file:./dev.db"

# Cache & Redis (production recommended)
CACHE_DRIVER="memory" # "memory" | "redis"
REDIS_URL="redis://localhost:6379"
REDIS_REQUIRED="false"
ALLOWED_ORIGINS="http://localhost:3000"
TRUST_PROXY_HOPS="0"

SESSION_SECRET="CHANGE_ME_IN_PRODUCTION_MIN_32_RANDOM_CHARS"
EROGAAI_SECRET_KEY="CHANGE_ME_HEX_OR_BASE64_32_BYTES_SECRET_KEY"

# Managed Platform Default Keys (Optional BYOK fallback)
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENAI_API_KEY=""

# Optional local OCR fallback cache. Defaults to ./data/tesseract.
TESSERACT_CACHE_PATH="./data/tesseract"
LOCAL_OCR_CONFIDENCE_THRESHOLD="78"

# Backend-only taxpayer lookup. No secret is required by the current public contract.
DGII_PROVIDER_BASE_URL="https://rnc.megaplus.com.do"
DGII_PROVIDER_TIMEOUT_MS="7000"

CODEMORF_API_URL="https://codemorf.tech/api/v1"
CODEMORF_API_KEY=""

SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="no-reply@erogaai.com"
SMTP_FROM_NAME="ErogaAI SaaS"

ALLSENDER_ERP_API_URL="https://api.allsender.com/v1/accounting/invoices"
ALLSENDER_ERP_API_KEY=""

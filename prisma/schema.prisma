generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Organization {
  id                  String               @id @default(uuid())
  name                String
  rnc                 String
  currency            String               @default("DOP")
  plan                String               @default("PROFESSIONAL")
  address             String?
  phone               String?
  logo_url            String?
  is_active           Boolean              @default(true)
  monthly_scans_used  Int                  @default(0)
  monthly_scans_limit Int                  @default(1000)
  storage_mb_used     Int                  @default(0)
  storage_mb_limit    Int                  @default(5000)
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt

  companies           Company[]
  branches            Branch[]
  users               User[]
  memberships         Membership[]
  sessions            Session[]
  roles               Role[]
  expenses            Expense[]
  categories          ExpenseCategory[]
  cost_centers        CostCenter[]
  suppliers           Supplier[]
  projects            Project[]
  vehicles            Vehicle[]
  receipts            Receipt[]
  ai_provider_configs AIProviderConfig[]
  ai_usage_logs       AIUsageLog[]
  api_keys            ApiKey[]
  api_key_logs        ApiKeyLog[]
  webhook_subs        WebhookSubscription[]
  audit_logs          AuditLog[]
  erp_configs         ERPConfig[]
  erp_sync_jobs       ERPSyncJob[]
  email_settings      EmailSettings[]
  report_schedules    ReportSchedule[]
  report_runs         ReportRun[]
}

model Company {
  id              String      @id @default(uuid())
  organization_id String
  name            String
  trade_name      String?
  rnc             String
  id_type         String      @default("RNC")
  tax_regime      String      @default("REGIMEN_GENERAL")
  address         String
  province        String
  municipality    String
  sector          String?
  phone           String?
  email           String?
  logo_url        String?
  currency        String      @default("DOP")
  country         String      @default("Dominican Republic")
  timezone        String      @default("America/Santo_Domingo")
  is_main         Boolean     @default(false)
  status          String      @default("ACTIVO")
  is_active       Boolean     @default(true)
  created_by      String?
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  branches        Branch[]
  expenses        Expense[]
  api_keys        ApiKey[]
}

model Branch {
  id              String       @id @default(uuid())
  company_id      String
  organization_id String
  name            String
  code            String
  address         String
  province        String?
  municipality    String?
  phone           String?
  responsible     String?
  status          String       @default("ACTIVO")
  is_active       Boolean      @default(true)
  created_by      String?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  company         Company      @relation(fields: [company_id], references: [id], onDelete: Cascade)
  expenses        Expense[]
  api_keys        ApiKey[]
}

model User {
  id              String       @id @default(uuid())
  organization_id String
  email           String       @unique
  password_hash   String
  name            String
  role            String       @default("EMPLOYEE")
  department      String?
  avatar          String?
  status          String       @default("ACTIVE")
  is_active       Boolean      @default(true)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  memberships     Membership[]
  sessions        Session[]
  expenses        Expense[]
  audit_logs      AuditLog[]
}

model Membership {
  id              String       @id @default(uuid())
  organization_id String
  user_id         String
  role            String       @default("EMPLOYEE")
  status          String       @default("ACTIVE")
  is_active       Boolean      @default(true)
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Session {
  id              String       @id @default(uuid())
  token           String       @unique
  user_id         String
  organization_id String
  expires_at      DateTime
  ip_address      String?
  user_agent      String?
  is_revoked      Boolean      @default(false)
  created_at      DateTime     @default(now())

  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Role {
  id              String           @id @default(uuid())
  organization_id String
  name            String
  description     String?
  is_system       Boolean          @default(false)
  color           String?          @default("blue")
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  organization    Organization     @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  permissions     RolePermission[]
}

model Permission {
  id              String           @id @default(uuid())
  key             String           @unique
  category        String
  category_label  String
  name            String
  description     String

  roles           RolePermission[]
}

model RolePermission {
  role_id       String
  permission_id String

  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
}

model Expense {
  id                      String       @id @default(uuid())
  organization_id         String
  company_id              String
  company_name            String?
  branch_id               String?
  branch_name             String?
  created_by_user_id      String
  created_by_user_name    String
  idempotency_key         String?      @unique
  external_id             String?      @unique

  supplier_name           String
  supplier_rnc            String
  ncf                     String
  ncf_type                String       @default("B01")
  ncf_modified            String?
  expense_date            String
  issue_date              String?
  document_type           String       @default("FACTURA_CREDITO_FISCAL")

  goods_amount            Float        @default(0)
  services_amount         Float        @default(0)
  subtotal                Float
  itbis_amount            Float        @default(0)
  itbis_retained          Float        @default(0)
  itbis_cost              Float        @default(0)
  itbis_proportionality   Float        @default(0)
  isr_retained            Float        @default(0)
  isr_retention_type      String?
  legal_tip_amount        Float        @default(0)
  other_taxes             Float        @default(0)
  total_amount            Float
  currency                String       @default("DOP")
  payment_method          String       @default("TARJETA_EMPRESARIAL")
  dgii_expense_type       String?
  dgii_payment_type       String?

  classification          String       @default("GASTO_OPERATIVO")
  expense_category        String
  cost_center_id          String?
  cost_center_name        String?
  project_id              String?
  project_name            String?
  vehicle_id              String?
  vehicle_name            String?
  notes                   String?

  status                  String       @default("PENDIENTE_REVISION")
  approval_notes          String?
  correction_request_note String?
  reviewed_by             String?
  reviewed_at             DateTime?

  receipt_image_url       String?
  receipt_thumbnail_url   String?
  ocr_raw_text            String?
  ai_confidence_score     Float        @default(0)
  ai_provider_used        String       @default("GEMINI")
  ai_model_used           String       @default("gemini-2.5-flash")

  all_sender_sync_id      String?
  all_sender_synced_at    DateTime?
  erp_sync_status         String       @default("PENDIENTE_SYNC")
  erp_sync_attempts       Int          @default(0)
  erp_sync_error          String?
  erp_response_payload    String?

  created_at              DateTime     @default(now())
  updated_at              DateTime     @updatedAt

  organization            Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  company                 Company      @relation(fields: [company_id], references: [id], onDelete: Cascade)
  branch                  Branch?      @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  created_by              User         @relation(fields: [created_by_user_id], references: [id], onDelete: Cascade)
  items                   ExpenseItem[]
}

model ExpenseItem {
  id           String   @id @default(uuid())
  expense_id   String
  description  String
  quantity     Float    @default(1)
  unit_price   Float
  itbis_rate   Float    @default(18)
  total        Float

  expense      Expense  @relation(fields: [expense_id], references: [id], onDelete: Cascade)
}

model ExpenseCategory {
  id                      String       @id @default(uuid())
  organization_id         String
  name                    String
  code                    String
  account_code            String
  dgii_type_code          String
  default_classification  String       @default("GASTO_OPERATIVO")
  default_itbis_rate      Float        @default(18)
  monthly_budget          Float        @default(0)
  icon                    String?
  color                   String?
  is_active               Boolean      @default(true)
  is_system               Boolean      @default(false)
  requires_approval_above Float?
  created_at              DateTime     @default(now())

  organization            Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
}

model CostCenter {
  id                    String       @id @default(uuid())
  organization_id       String
  code                  String
  name                  String
  manager_name          String?
  budget_monthly        Float        @default(0)
  spent_current_month   Float        @default(0)

  organization          Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
}

model Supplier {
  id               String       @id @default(uuid())
  organization_id  String
  rnc              String
  name             String
  trade_name       String?
  phone            String?
  email            String?
  category_default String?
  status_dgii      String       @default("ACTIVO")
  total_invoiced   Float        @default(0)
  created_at       DateTime     @default(now())

  organization     Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
}

model Project {
  id              String       @id @default(uuid())
  organization_id String
  code            String
  name            String
  client_name     String?
  budget          Float        @default(0)
  spent           Float        @default(0)
  status          String       @default("ACTIVO")

  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
}

model Vehicle {
  id               String       @id @default(uuid())
  organization_id  String
  plate            String
  brand            String
  model            String
  driver_name      String?
  fuel_type        String       @default("GASOIL_OPTIMO")
  total_fuel_spent Float        @default(0)
  last_mileage     Float?

  organization     Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
}

model Receipt {
  id                 String       @id @default(uuid())
  organization_id    String
  status             String       @default("PROCESSED")
  image_url          String?
  file_name          String?
  mime_type          String?
  provider_used      String?
  model_used         String?
  confidence_score   Float?
  duration_ms        Int?
  error              String?
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt

  organization       Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
}

model AIProviderConfig {
  id                    String       @id @default(uuid())
  organization_id       String
  provider_type         String
  name                  String
  encrypted_key         String?
  masked_key            String
  has_key               Boolean      @default(false)
  selected_model        String
  available_models_json String       @default("[]")
  is_active             Boolean      @default(true)
  is_primary            Boolean      @default(false)
  is_secondary_fallback Boolean      @default(false)
  total_requests        Int          @default(0)
  total_tokens          Int          @default(0)
  last_used_at          DateTime?
  status                String       @default("ONLINE")
  last_test_message     String?
  created_at            DateTime     @default(now())

  organization          Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
}

model AIUsageLog {
  id                 String       @id @default(uuid())
  organization_id    String
  provider_type      String
  model              String
  expense_id         String?
  action             String
  tokens_prompt      Int          @default(0)
  tokens_completion  Int          @default(0)
  duration_ms        Int          @default(0)
  status             String       @default("SUCCESS")
  created_at         DateTime     @default(now())

  organization       Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
}

model ApiKey {
  id              String       @id @default(uuid())
  organization_id String
  company_id      String
  company_name    String?
  branch_id       String?
  branch_name     String?
  name            String
  key_hash        String       @unique
  masked_key      String
  key_prefix      String?
  scopes_json     String       @default("[]")
  expires_at      DateTime?
  last_used_at    DateTime?
  total_requests  Int          @default(0)
  is_active       Boolean      @default(true)
  status          String       @default("ACTIVE")
  created_by      String
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  company         Company      @relation(fields: [company_id], references: [id], onDelete: Cascade)
  branch          Branch?      @relation(fields: [branch_id], references: [id], onDelete: SetNull)
  logs            ApiKeyLog[]
}

model ApiKeyLog {
  id              String       @id @default(uuid())
  api_key_id      String
  api_key_name    String?
  organization_id String
  endpoint        String
  method          String
  status_code     Int
  ip_address      String
  latency_ms      Int
  duration_ms     Int?
  created_at      DateTime     @default(now())

  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  api_key         ApiKey       @relation(fields: [api_key_id], references: [id], onDelete: Cascade)
}

model WebhookSubscription {
  id               String       @id @default(uuid())
  organization_id  String
  url              String
  events_json      String       @default("[]")
  secret           String
  is_active        Boolean      @default(true)
  created_at       DateTime     @default(now())
  last_triggered_at DateTime?

  organization     Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
}

model AuditLog {
  id              String       @id @default(uuid())
  organization_id String
  user_id         String
  user_name       String
  action          String
  entity_type     String
  entity_id       String
  details         String
  before_state    String?
  after_state     String?
  result          String       @default("SUCCESS")
  ip_address      String?
  user_agent      String?
  request_id      String?
  created_at      DateTime     @default(now())

  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model ERPConfig {
  id                     String       @id @default(uuid())
  organization_id        String       @unique
  is_enabled             Boolean      @default(false)
  api_endpoint           String
  encrypted_api_key      String?
  api_key_masked         String
  target_company_id      String?
  target_branch_id       String?
  auto_sync_on_approval  Boolean      @default(false)
  ledger_account_default String       @default("6105-01-000")
  last_sync_time         DateTime?
  last_test_time         DateTime?
  last_error_message     String?
  sync_status            String       @default("DESACTIVADO")

  organization           Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
}

model ERPSyncJob {
  id              String       @id @default(uuid())
  organization_id String
  expense_ids     String
  status          String       @default("PENDING") // PENDING, PROCESSING, SUCCESS, FAILED, RETRYING
  synced_count    Int          @default(0)
  failed_count    Int          @default(0)
  error_message   String?
  http_code       Int?
  request_id      String?
  created_at      DateTime     @default(now())
  updated_at      DateTime     @updatedAt

  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
}

model EmailSettings {
  id              String       @id @default(uuid())
  organization_id String       @unique
  smtp_host       String?
  smtp_port       Int?         @default(587)
  smtp_secure     Boolean      @default(false)
  smtp_user       String?
  encrypted_pass  String?
  smtp_from       String?
  smtp_from_name  String?      @default("ErogaAI System")
  is_active       Boolean      @default(false)
  updated_at      DateTime     @updatedAt

  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
}

model ReportSchedule {
  id              String       @id @default(uuid())
  organization_id String
  title           String
  frequency       String       @default("MONTHLY") // DAILY, WEEKLY, MONTHLY
  recipients_json String       @default("[]")
  report_types    String       @default("GASTOS_DGII")
  attach_pdf      Boolean      @default(true)
  attach_xlsx     Boolean      @default(true)
  is_active       Boolean      @default(true)
  last_sent_at    DateTime?
  next_run_at     DateTime?
  created_at      DateTime     @default(now())

  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade)
  runs            ReportRun[]
}

model ReportRun {
  id            String         @id @default(uuid())
  schedule_id   String
  status        String         @default("SUCCESS")
  recipients    String
  error_message String?
  attempts      Int            @default(1)
  executed_at   DateTime       @default(now())

  schedule      ReportSchedule @relation(fields: [schedule_id], references: [id], onDelete: Cascade)
}
